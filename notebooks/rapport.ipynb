    "base = ajouter_tranche_ips(base)\n",
    "\n",
    "for filiere in [\"CPGE\", \"BTS\"]:\n",
    "    formations = base[base[\"filiere\"] == filiere]\n",
    "    # Une ligne par quart d'IPS, une colonne par session : on garde 2018 et 2025\n",
    "    part = boursiers_admis_et_candidats(formations, [\"tranche_ips\", \"session\"])[\"part_admis\"].unstack()\n",
    "    part.index.name = \"Quart d'IPS du lycée qui accueille la formation\"\n",
    "    barres(part[[2018, 2025]],\n",
    "           titre=f\"{filiere} : part de boursiers parmi les admis, selon le milieu social du lycée\",\n",
    "           axe_y=\"Boursiers parmi les néo-bacheliers admis (%)\",\n",
