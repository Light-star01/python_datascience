    "# Les deux indicateurs côte à côte, en %, de 2016 à 2025 (Parcoursup commence en 2018)\n",
    "idf = pd.DataFrame({\n",
    "    \"Admis de l'académie de Paris, dans les formations parisiennes\": part_admis_meme_academie(base, \"Paris\"),\n",
    "    \"Bacheliers franciliens poursuivant dans une autre académie d'IDF\": part_poursuite_autre_academie_idf(poursuite),\n",
    "}).loc[2016:]\n",
    "\n",
    "courbes(idf,\n",
    "        titre=\"Île-de-France : mobilité entre académies avant et après le secteur unique\",\n",
    "        axe_y=\"Part (%)\",\n",
    "        source=\"Parcoursup 2018-2025 ; MESR, taux de poursuite des néo-bacheliers\",\n",
    "        annee_reperee=2019, texte_repere=\"Secteur unique IDF\");\n",
    "idf"
   ]
